# Network
PORT=3000
HOST=0.0.0.0
# Runtime selector for launchers/scripts: v1 | v2
# RUNTIME_VERSION=v1
# NETWORK_MODE=server

# HTTPS (recommended for remote clients)
# SSL_KEY_PATH=certs/dev-key.pem
# SSL_CERT_PATH=certs/dev-cert.pem
# SSL_CA_PATH=certs/dev-ca.pem

# STUN override (comma-separated)
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.nextcloud.com:443

# TURN (recommended for production)
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_USERNAME=your-user
# TURN_PASSWORD=your-password

# all | relay
# ICE_TRANSPORT_POLICY=all

# Relay V2 large encrypted attachments (S3 multipart)
# RELAY_CAPABILITY_SECRET=change-me
# RELAY_CAPABILITY_TTL_MS=300000
# RELAY_UPLOAD_SESSION_TTL_MS=86400000
# RELAY_SIGNED_URL_TTL_SECONDS=900
# RELAY_MAX_FILE_BYTES=10737418240
# RELAY_MAX_TOTAL_MESSAGE_BYTES=10737418240
# RELAY_UPLOAD_CHUNK_SIZE_BYTES=16777216
# V2 backend-specific limits (if set, override generic relay limits)
# RELAY_V2_MAX_FILE_BYTES=10737418240
# RELAY_V2_MAX_TOTAL_MESSAGE_BYTES=10737418240
# Optional V2 persistence layer
# V2_POSTGRES_URL=postgres://user:pass@localhost:5432/synto
# V2_REDIS_URL=redis://localhost:6379
# RELAY_S3_BUCKET=voice-relay
# RELAY_S3_REGION=eu-central-1
# RELAY_S3_ENDPOINT=
# RELAY_S3_FORCE_PATH_STYLE=0
